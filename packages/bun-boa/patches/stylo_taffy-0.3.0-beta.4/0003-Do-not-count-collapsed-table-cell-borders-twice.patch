Date: Sat, 21 Nov 2026 10:31:46 +0000
Subject: [PATCH] Do not count collapsed table cell borders twice

Port of https://github.com/DioxusLabs/blitz/pull/1702.

Left out, outside the crate: tests/blitz-tests/tests/all.rs, tests/blitz-tests/tests/table_collapsed_borders.rs.
---
 src/wrapper.rs | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/wrapper.rs b/src/wrapper.rs
index aaa531b..cbaabd9 100644
--- a/src/wrapper.rs
+++ b/src/wrapper.rs
@@ -317,6 +317,14 @@ impl<T: Deref<Target = ComputedValues>> taffy::CoreStyle for TaffyStyloStyle<T>
 
     #[inline]
     fn border(&self) -> taffy::Rect<taffy::LengthPercentage> {
+        // In the collapsing border model a cell's borders are laid out by the
+        // table, between the cells, not inside the cell's own box.
+        if self.effective_display().inside() == stylo::DisplayInside::TableCell
+            && self.style.clone_border_collapse()
+                == style::computed_values::border_collapse::T::Collapse
+        {
+            return taffy::Rect::zero();
+        }
         let border_styles = self.style.get_border();
         self.rect(taffy::Rect {
             left: convert::border(
