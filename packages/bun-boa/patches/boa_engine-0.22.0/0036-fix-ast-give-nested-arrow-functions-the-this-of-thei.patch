From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ju=CC=88rg=20Lehni?= <juerg@scratchdisk.com>
Date: Tue, 24 Nov 2026 21:27:18 +0000
Subject: [PATCH] fix(ast): give nested arrow functions the `this` of their
 enclosing function

Port of https://github.com/boa-dev/boa/pull/5691.

Adapted to the kitesurf scope patches: Inner also has lookup/lookup_dropped, and the new arrow flag is carried through KsScopeParts (ks_parts/ks_rebuild) and stored as bit 2 of the scope flags byte in ks_body.rs, so a rebuilt arrow scope stays an arrow scope.
---
 src/ks_body.rs        |  7 ++++++-
 src/tests/function.rs | 15 +++++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/ks_body.rs b/src/ks_body.rs
index 25d3716..80501e0 100644
--- a/src/ks_body.rs
+++ b/src/ks_body.rs
@@ -275,7 +275,11 @@ impl ScopeTable {
             w.u32(self.outer_ref(scope));
             w.u32(parts.unique_id);
             w.u32(parts.index);
-            w.u8(u8::from(parts.function) | (u8::from(parts.this_escaped) << 1));
+            w.u8(
+                u8::from(parts.function)
+                    | (u8::from(parts.this_escaped) << 1)
+                    | (u8::from(parts.arrow) << 2),
+            );
             w.u32(parts.bindings.len() as u32);
             for (name, index, flags) in &parts.bindings {
                 w.u32(strings.id(name));
@@ -305,6 +309,7 @@ impl ScopeTable {
                 unique_id,
                 index,
                 function: flags & 1 != 0,
+                arrow: flags & 4 != 0,
                 this_escaped: flags & 2 != 0,
                 bindings,
             };
diff --git a/src/tests/function.rs b/src/tests/function.rs
index 84cb0c8..7ba2303 100644
--- a/src/tests/function.rs
+++ b/src/tests/function.rs
@@ -324,3 +324,18 @@ fn function_constructor_nested_lexical_binding() {
         42,
     )]);
 }
+
+#[test]
+fn nested_arrow_functions_have_the_this_of_their_method() {
+    run_test_actions([
+        TestAction::run(indoc! {r#"
+            const object = {
+                method() {
+                    return [1].map(() => [2].map(() => this.value));
+                },
+                value: 3,
+            };
+        "#}),
+        TestAction::assert_eq("object.method()[0][0]", 3),
+    ]);
+}
