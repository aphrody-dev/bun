From c49049c7e95cf7ec10f655b4f11daef17fccf602 Mon Sep 17 00:00:00 2001
From: aphrody-dev <contact@aphrody.com>
Date: Thu, 26 Nov 2026 02:06:49 +0100
Subject: [PATCH 1/5] Build outside the Blitz workspace: spell out the
 inherited manifest fields

---
 Cargo.toml | 60 +++++++++++++++++++-----------------------------------
 1 file changed, 21 insertions(+), 39 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 60fbf97..3f06c57 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -2,13 +2,13 @@
 name = "blitz-vibey-script"
 description = "JavaScript execution for Blitz using the Boa engine"
 documentation = "https://docs.rs/blitz-vibey-script"
-version.workspace = true
-license.workspace = true
-homepage.workspace = true
-repository.workspace = true
-categories.workspace = true
-edition.workspace = true
-rust-version.workspace = true
+version = "0.3.0-beta.4"
+license = "MIT OR Apache-2.0"
+homepage = "https://github.com/dioxuslabs/blitz"
+repository = "https://github.com/dioxuslabs/blitz"
+categories = ["gui"]
+edition = "2024"
+rust-version = "1.91.0"
 publish = false
 
 [features]
@@ -16,36 +16,18 @@ default = []
 tracing = ["dep:tracing", "blitz-dom/tracing"]
 
 [dependencies]
-# Blitz dependencies
-blitz-dom = { workspace = true, features = ["autofocus"] }
-blitz-html = { workspace = true }
-blitz-traits = { workspace = true }
-
-# Boa (JavaScript engine)
-# `annex-b` enables the Annex B (web-compatibility) ECMAScript features
-# (String.prototype.substr, escape/unescape, HTML comments in scripts, ...)
-# which all browsers implement and web content relies on
-boa_engine = { workspace = true, features = ["annex-b"] }
-boa_runtime = { workspace = true }
-boa_gc = { workspace = true }
-
-# Servo dependencies
-markup5ever = { workspace = true }
-style = { workspace = true }
-
-# Other dependencies
-icu_properties = { workspace = true }
-keyboard-types = { workspace = true }
+blitz-dom = { version = "=0.3.0-beta.4", default-features = false, features = ["autofocus"] }
+blitz-html = { version = "=0.3.0-beta.4", default-features = false }
+blitz-traits = { version = "=0.3.0-beta.4", default-features = false }
+boa_engine = { version = "0.22", features = ["annex-b"] }
+boa_runtime = "0.22"
+boa_gc = "0.22"
+markup5ever = "0.40.0"
+style = { version = "0.22.0", package = "stylo" }
+icu_properties = { version = "2.3", default-features = false, features = ["compiled_data"] }
+keyboard-types = "0.8"
 log = "0.4"
-url = { workspace = true }
-data-url = { workspace = true }
-web-time = { workspace = true }
-tracing = { workspace = true, optional = true }
-
-[dev-dependencies]
-blitz-traits = { workspace = true }
-# system-fonts is needed so that text inputs shape real text in tests
-# (the selection tests depend on cursor placement within a text layout)
-blitz-dom = { workspace = true, features = ["system-fonts", "text-transform-icu"] }
-keyboard-types = { workspace = true }
-url = { workspace = true }
+url = "2.5.0"
+data-url = "0.3.1"
+web-time = "1"
+tracing = { version = "0.1.40", optional = true }
-- 
2.56.1

