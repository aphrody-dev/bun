 src/dom/document.rs  | 10 +++++-----
 src/dom/element.rs   | 26 +++++++++++-------------
 src/dom/mod.rs       |  6 +++---
 src/dom/node.rs      | 30 +++++++++++++++-------------
 src/dom/selection.rs | 47 ++++++++++++++++++++------------------------
 src/inner_text.rs    | 43 ++++++++++++++++++++--------------------
 src/runtime.rs       | 16 +++++++--------
 8 files changed, 89 insertions(+), 93 deletions(-)

