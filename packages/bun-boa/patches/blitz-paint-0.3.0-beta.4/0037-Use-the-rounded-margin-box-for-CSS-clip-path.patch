From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zhangzhaohong-dev <zhangzhaohong.dev@gmail.com>
Date: Sun, 22 Nov 2026 16:30:43 +0000
Subject: [PATCH] Use the rounded margin box for CSS clip-path

Port of https://github.com/DioxusLabs/blitz/pull/1726.

Adapted to the patched paint path: the outline keeps its scene-part marker, the outset shadow is not gated on paints_own_box (absent here), and the empty-clip-region early return now skips outline and shadow too since the clip covers them. The margin box keeps the element's corner-shape.
---
 src/render.rs           | 28 ++++++------------
 src/render/clip_path.rs | 64 +++++++++++++++++++++++++++++++++--------
 2 files changed, 60 insertions(+), 32 deletions(-)

diff --git a/src/render.rs b/src/render.rs
index 7d66190..7abcc96 100644
--- a/src/render.rs
+++ b/src/render.rs
@@ -574,32 +574,16 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
 
         // An empty clip-path region means every pixel the subtree paints is discarded
         // by the layer that wraps it, so the whole traversal below is dead work.
-        let clipped_away = is_empty_clip_region(clip_path_shape.as_ref());
-
-        scene.begin_part(node_id.as_u64(), ScenePart::Outline);
-        cx.draw_outline(scene);
-        scene.end_part();
-        cx.draw_outset_box_shadow(scene);
-
-        // Outline and outset shadow paint outside the clip-path layer here, so they
-        // stay above the skip to keep an empty-clipped frame pixel-identical.
-        if clipped_away {
+        // The clip-path layer also clips the outline and outset shadow, so nothing is painted.
+        if is_empty_clip_region(clip_path_shape.as_ref()) {
             self.layer_manager
                 .maybe_pop_layer(scene, css_clip_layer_pushed);
             return;
         }
 
-        // Only the clip-path maybe_with_layer call below reads this, and it
-        // does nothing when its flag is false, the common case for an element.
-        let clip_path_for_layer = if has_clip_path {
-            let mut path = clip_path_shape.unwrap_or_else(|| cx.frame.border_box_path());
-            path.apply_affine(Affine::scale(self.scale));
-            path
-        } else {
-            BezPath::new()
-        };
+        let clip_path_for_layer = clip_path_shape.unwrap_or_default();
 
-        // clip-path clip ayer
+        // Apply clip-path to decorations as well as the element's content.
         self.layer_manager.maybe_with_layer(
             scene,
             has_clip_path,
@@ -612,6 +596,10 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
                 // If the element has a CSS `mask`, then push an isolation layer for the
                 // masked content. The mask is applied when the layer is popped below.
                 let mask_layer_pushed = cx.maybe_push_css_mask_layer(scene);
+                scene.begin_part(node_id.as_u64(), ScenePart::Outline);
+                cx.draw_outline(scene);
+                scene.end_part();
+                cx.draw_outset_box_shadow(scene);
                 // `cx.transform` is mutated to apply scroll offsets while drawing content.
                 // Save it so that the mask can be drawn untransformed by scroll offsets.
                 let unscrolled_transform = cx.transform;
diff --git a/src/render/clip_path.rs b/src/render/clip_path.rs
index 674b033..56eb17c 100644
--- a/src/render/clip_path.rs
+++ b/src/render/clip_path.rs
@@ -1,5 +1,6 @@
-use super::ElementCx;
-use kurbo::{BezPath, Circle, Ellipse, Point, Rect, Shape, SvgArc, Vec2};
+use super::{ElementCx, insets_from_taffy_rect};
+use crate::kurbo_css::{CssBox, NonUniformRoundedRectRadii};
+use kurbo::{Affine, BezPath, Insets, Circle, Ellipse, Point, Rect, Shape, SvgArc, Vec2};
 use style::values::computed::basic_shape::{BasicShape, ClipPath};
 use style::values::computed::{Angle, CSSPixelLength, LengthPercentage};
 use style::values::generics::basic_shape::{
@@ -53,15 +54,52 @@ impl ElementCx<'_, '_> {
             }
             ClipPath::Shape(basic_shape, geometry_box) => {
                 let reference_box = self.resolve_geometry_box(&geometry_box);
-                self.basic_shape_to_path(&basic_shape, reference_box)
-            }
-            ClipPath::Box(geometry_box) => {
-                let reference_box = self.resolve_geometry_box(&geometry_box);
-                Some(Rect::from(reference_box).into_path(0.1))
+                let mut path = self.basic_shape_to_path(&basic_shape, reference_box)?;
+                path.apply_affine(Affine::scale(self.scale));
+                Some(path)
             }
+            ClipPath::Box(geometry_box) => Some(match geometry_box {
+                ShapeGeometryBox::ShapeBox(ShapeBox::MarginBox) => {
+                    self.margin_box().border_box_path()
+                }
+                ShapeGeometryBox::ShapeBox(ShapeBox::PaddingBox) => self.frame.padding_box_path(),
+                ShapeGeometryBox::ShapeBox(ShapeBox::ContentBox) | ShapeGeometryBox::FillBox => {
+                    self.frame.content_box_path()
+                }
+                _ => self.frame.border_box_path(),
+            }),
         }
     }
 
+    fn margin_box(&self) -> CssBox {
+        let margin = insets_from_taffy_rect(
+            self.node
+                .final_layout()
+                .margin
+                .map(|v| f64::from(v) * self.scale),
+        );
+        let rect = self.frame.border_box + margin;
+        let rect = Rect::new(rect.x0, rect.y0, rect.x1.max(rect.x0), rect.y1.max(rect.y0));
+        let adjust = |radius: f64, offset: f64| {
+            let offset = if offset > radius {
+                offset * (1.0 + (radius / offset - 1.0).powi(3))
+            } else {
+                offset
+            };
+            (radius + offset).max(0.0)
+        };
+        let corner = |radius: Vec2, x, y| Vec2::new(adjust(radius.x, x), adjust(radius.y, y));
+        let radii = self.frame.border_radii;
+        let radii = NonUniformRoundedRectRadii {
+            top_left: corner(radii.top_left, margin.x0, margin.y0),
+            top_right: corner(radii.top_right, margin.x1, margin.y0),
+            bottom_right: corner(radii.bottom_right, margin.x1, margin.y1),
+            bottom_left: corner(radii.bottom_left, margin.x0, margin.y1),
+        };
+        CssBox::new(rect, Insets::ZERO, Insets::ZERO, 0.0, radii)
+            .with_corner_shapes(self.frame.corner_shapes)
+    }
+
     /// Resolve a ShapeGeometryBox to a concrete rectangle (x, y, width, height) in scaled pixels
     ///
     /// For SVG elements without associated CSS layout box, the used value for content-box and padding-box is fill-box and for border-box and margin-box is stroke-box.
@@ -92,12 +130,14 @@ impl ElementCx<'_, '_> {
                 }
             }
             ShapeGeometryBox::ShapeBox(ShapeBox::MarginBox) => {
-                // Margin box is not tracked in CssBox, fall back to border box
+                let margin = self.node.final_layout().margin;
                 ReferenceBox {
-                    x: 0.0,
-                    y: 0.0,
-                    width: self.frame.border_box.width() / self.scale,
-                    height: self.frame.border_box.height() / self.scale,
+                    x: -f64::from(margin.left),
+                    y: -f64::from(margin.top),
+                    width: (self.frame.border_box.width() / self.scale
+                        + f64::from(margin.left + margin.right)).max(0.0),
+                    height: (self.frame.border_box.height() / self.scale
+                        + f64::from(margin.top + margin.bottom)).max(0.0),
                 }
             }
         }
