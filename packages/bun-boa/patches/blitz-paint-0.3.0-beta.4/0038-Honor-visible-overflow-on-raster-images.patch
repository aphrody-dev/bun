From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zhangzhaohong-dev <zhangzhaohong.dev@gmail.com>
Date: Sun, 22 Nov 2026 16:44:33 +0000
Subject: [PATCH] Honor visible overflow on raster images

Port of https://github.com/DioxusLabs/blitz/pull/1729.

Adapted to the inline should_clip computation here (no should_clip_node helper); a raster image still clips both axes once either axis clips (it stays in clip_only_axis).
---
 src/render.rs | 39 +++++++++++++++++++++++----------------
 1 file changed, 23 insertions(+), 16 deletions(-)

diff --git a/src/render.rs b/src/render.rs
index 7abcc96..8d786c2 100644
--- a/src/render.rs
+++ b/src/render.rs
@@ -425,8 +425,7 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
         let is_root_element = self.root_element_id == Some(node_id);
         let should_clip = !is_root_element
             && !self.dom.propagates_overflow_to_viewport(node_id)
-            && (is_image
-                || is_sub_doc
+            && (is_sub_doc
                 || is_text_input
                 || contain_paint
                 || !matches!(overflow_x, Overflow::Visible)
@@ -489,10 +488,13 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
         // Cull elements that fall entirely outside the current clip rectangle. In addition to
         // the viewport, `clip_rect` is narrowed by any ancestor scrollport (see below), so this
         // also culls elements scrolled out of view inside a clipping/scrolling container.
-        if screen_bbox.x1 < clip_rect.x0
-            || screen_bbox.x0 > clip_rect.x1
-            || screen_bbox.y1 < clip_rect.y0
-            || screen_bbox.y0 > clip_rect.y1
+        let raster_overflow_visible = !should_clip
+            && node.element_data().and_then(|e| e.raster_image_data()).is_some();
+        if !raster_overflow_visible
+            && (screen_bbox.x1 < clip_rect.x0
+                || screen_bbox.x0 > clip_rect.x1
+                || screen_bbox.y1 < clip_rect.y0
+                || screen_bbox.y0 > clip_rect.y1)
         {
             return;
         }
@@ -1598,16 +1600,21 @@ impl ElementCx<'_, '_> {
                 .pre_translate(Vec2 { x, y })
                 .pre_scale_non_uniform(x_scale, y_scale);
 
-            self.with_replaced_content_clip(
-                scene,
-                container_size,
-                paint_size,
-                x_offset.px(),
-                y_offset.px(),
-                |scene| {
-                    scene.draw_image(to_peniko_image(image, quality).as_ref(), transform);
-                },
-            );
+            let box_style = self.style.get_box();
+            if box_style.overflow_x == Overflow::Visible && box_style.overflow_y == Overflow::Visible {
+                scene.draw_image(to_peniko_image(image, quality).as_ref(), transform);
+            } else {
+                self.with_replaced_content_clip(
+                    scene,
+                    container_size,
+                    paint_size,
+                    x_offset.px(),
+                    y_offset.px(),
+                    |scene| {
+                        scene.draw_image(to_peniko_image(image, quality).as_ref(), transform);
+                    },
+                );
+            }
         }
     }
 
