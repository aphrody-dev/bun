From: zhangzhaohong-dev <zhangzhaohong.dev@gmail.com>
Date: Tue, 24 Nov 2026 17:29:44 +0000
Subject: [PATCH] Match CSS language selectors from DOM language attributes

Port of https://github.com/DioxusLabs/blitz/pull/1755.

Replaces the baseline's lang-only prefix match in src/stylo.rs, and declared_language reads the packed attribute and element namespaces. Patch 0069's ancestor restyle on lang writes now also covers xml:lang, which :lang() reads from now on.
---
 src/mutator.rs      | 10 +++--
 src/node/element.rs | 20 ++++++++++
 src/stylo.rs        | 93 +++++++++++++++++++++++----------------------
 3 files changed, 74 insertions(+), 49 deletions(-)

diff --git a/src/mutator.rs b/src/mutator.rs
index 3687346..49e65af 100644
--- a/src/mutator.rs
+++ b/src/mutator.rs
@@ -402,10 +402,12 @@ impl DocumentMutator<'_> {
     /// `:dir()` and `:lang()` can depend on this element's inherited state.
     /// Restyle from its parent to include descendants and later `+`/`~` siblings.
     fn restyle_inherited_attr_write(&mut self, node_id: NodeId, name: &QualName) {
-        if name.ns != ns!()
-            || (name.local != local_name!("dir") && name.local != local_name!("lang"))
-            || !self.doc.nodes[node_id].is_element()
-        {
+        let inherited = if name.ns == ns!() {
+            name.local == local_name!("dir") || name.local == local_name!("lang")
+        } else {
+            name.ns == ns!(xml) && name.local == local_name!("lang")
+        };
+        if !inherited || !self.doc.nodes[node_id].is_element() {
             return;
         }
 
diff --git a/src/node/element.rs b/src/node/element.rs
index 2048914..cad48bf 100644
--- a/src/node/element.rs
+++ b/src/node/element.rs
@@ -1364,6 +1364,26 @@ impl ElementData {
         &self.attrs
     }
 
+    /// Language declared on this element, before inheritance.
+    pub(crate) fn declared_language(&self) -> Option<&str> {
+        let mut language = None;
+        for attr in self
+            .attrs
+            .iter()
+            .filter(|attr| attr.name.local == local_name!("lang"))
+        {
+            if *attr.namespace() == ns!(xml) {
+                return Some(attr.value.as_str());
+            }
+            if *attr.namespace() == ns!()
+                && (*self.namespace() == ns!(html) || *self.namespace() == ns!(svg))
+            {
+                language = Some(attr.value.as_str());
+            }
+        }
+        language
+    }
+
     pub fn attr(&self, name: impl PartialEq<LocalName>) -> Option<&str> {
         let attr = self.attrs.iter().find(|attr| name == attr.name.local)?;
         Some(&attr.value)
