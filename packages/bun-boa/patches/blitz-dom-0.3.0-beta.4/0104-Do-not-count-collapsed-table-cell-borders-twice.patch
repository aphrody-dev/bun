From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bahad=C4=B1r?= <dogrubahadir@gmail.com>
Date: Sat, 21 Nov 2026 10:31:46 +0000
Subject: [PATCH] Do not count collapsed table cell borders twice

Port of https://github.com/DioxusLabs/blitz/pull/1702.

Left out, outside the crate: tests/blitz-tests/tests/all.rs, tests/blitz-tests/tests/table_collapsed_borders.rs.
---
 src/layout/table.rs | 64 +++++++++++++++++++++++++++++++--------------
 1 file changed, 45 insertions(+), 19 deletions(-)

diff --git a/src/layout/table.rs b/src/layout/table.rs
index 7d0a9a6..5fe6506 100644
--- a/src/layout/table.rs
+++ b/src/layout/table.rs
@@ -609,29 +609,55 @@ pub(crate) fn build_table_context(
                 height: style_helpers::length(spacing_y),
             }
         }
-        BorderCollapse::Collapse => first_cell_border
-            .as_ref()
-            .map(|border| {
-                let x = side_width(border.border_left_width.0, border.border_left_style).max(
-                    side_width(border.border_right_width.0, border.border_right_style),
-                );
-                let y = side_width(border.border_top_width.0, border.border_top_style).max(
-                    side_width(border.border_bottom_width.0, border.border_bottom_style),
-                );
-                taffy::Size {
-                    width: style_helpers::length(x),
-                    height: style_helpers::length(y),
-                }
-            })
-            .unwrap_or(taffy::Size::ZERO.map(style_helpers::length)),
+        // The grid has one gap per axis, so every collapsed border takes the widest cell
+        // border (a border between two cells resolves to the wider one, so a cell
+        // without borders next to cells with borders does not narrow the lines).
+        BorderCollapse::Collapse => {
+            let (mut x, mut y) = (0.0f32, 0.0f32);
+            for cell in &cells {
+                let Some(styles) = doc.nodes[cell.node_id].primary_styles() else {
+                    continue;
+                };
+                let border = styles.get_border();
+                x = x
+                    .max(side_width(
+                        border.border_left_width.0,
+                        border.border_left_style,
+                    ))
+                    .max(side_width(
+                        border.border_right_width.0,
+                        border.border_right_style,
+                    ));
+                y = y
+                    .max(side_width(
+                        border.border_top_width.0,
+                        border.border_top_style,
+                    ))
+                    .max(side_width(
+                        border.border_bottom_width.0,
+                        border.border_bottom_style,
+                    ));
+            }
+            taffy::Size {
+                width: style_helpers::length(x),
+                height: style_helpers::length(y),
+            }
+        }
     };
 
     if border_collapse == BorderCollapse::Collapse {
+        // The table's edge takes the wider of its own border and the cells'
+        // (as in Chromium, which resolves each outer border to the widest of
+        // the table's and the adjoining cells' borders).
+        let own = style.border.resolve_or_zero(None, resolve_calc_value);
+        let gap = style
+            .gap
+            .resolve_or_zero(taffy::Size::NONE, resolve_calc_value);
         style.border = taffy::Rect {
-            left: style.gap.width,
-            right: style.gap.width,
-            top: style.gap.height,
-            bottom: style.gap.height,
+            left: style_helpers::length(own.left.max(gap.width)),
+            right: style_helpers::length(own.right.max(gap.width)),
+            top: style_helpers::length(own.top.max(gap.height)),
+            bottom: style_helpers::length(own.bottom.max(gap.height)),
         };
     }
 
