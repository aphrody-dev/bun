From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zhangzhaohong-dev <zhangzhaohong.dev@gmail.com>
Date: Tue, 24 Nov 2026 16:11:37 +0000
Subject: [PATCH] Honor box sizing for empty inline contexts

Port of https://github.com/DioxusLabs/blitz/pull/1750.

Applied to the short circuit in layout/inline.rs, whose emptiness test here is the bidi-controls-only and evicted-layout check of earlier patches.
---
 src/layout/inline.rs | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/layout/inline.rs b/src/layout/inline.rs
index 05a7e20..26ab212 100644
--- a/src/layout/inline.rs
+++ b/src/layout/inline.rs
@@ -441,8 +441,11 @@ impl LayoutPassState<'_> {
         let text_kind = inline_layout.text_kind(&self.nodes);
         let text_is_only_bidi_controls = text_kind.only_bidi_controls;
 
-        // Short circuit if inline context contains no text or inline boxes
+        // Empty content still contributes the box's preferred and minimum sizes.
         if !has_styles_preventing_being_collapsed_through
+            && node_size == Size::NONE
+            && node_min_size == Size::NONE
+            && aspect_ratio.is_none()
             && text_is_only_bidi_controls
             && match inline_layout.live_layout() {
                 Some(layout) => layout.inline_boxes().len() == 0,
