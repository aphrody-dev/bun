From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zhangzhaohong-dev <zhangzhaohong.dev@gmail.com>
Date: Sun, 22 Nov 2026 16:21:04 +0000
Subject: [PATCH] Honor text-justify: none in inline layout

Port of https://github.com/DioxusLabs/blitz/pull/1722.

Applied to inline_alignment in layout/inline.rs, where this version keeps the inline alignment code.
---
 src/layout/inline.rs | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/src/layout/inline.rs b/src/layout/inline.rs
index f8e5372..05a7e20 100644
--- a/src/layout/inline.rs
+++ b/src/layout/inline.rs
@@ -1727,10 +1727,18 @@ impl crate::BaseDocument {
         self.nodes[node_id]
             .primary_styles()
             .map(|s| {
-                (
-                    stylo_to_parley::text_align(s.clone_text_align()),
-                    stylo_to_parley::text_align_last(s.clone_text_align_last()),
-                )
+                use parley::layout::Alignment;
+                let mut alignment = stylo_to_parley::text_align(s.clone_text_align());
+                let mut last_line = stylo_to_parley::text_align_last(s.clone_text_align_last());
+                if s.get_inherited_text().text_justify == style::values::computed::TextJustify::None {
+                    if alignment == Alignment::Justify {
+                        alignment = Alignment::Start;
+                    }
+                    if last_line == Some(Alignment::Justify) {
+                        last_line = Some(Alignment::Start);
+                    }
+                }
+                (alignment, last_line)
             })
             .unwrap_or((parley::layout::Alignment::Start, None))
     }
