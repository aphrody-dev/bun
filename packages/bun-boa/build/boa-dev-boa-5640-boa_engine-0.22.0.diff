+    run_test_actions([
+        TestAction::assert_eq(
+            indoc! {r#"
+                var n = 0, i, guard = 0;
+                a: b: for (i = 0; i < 3; i++) {
+                    c: for (;;) {
+                        if (++guard > 100) throw new Error("continue a restarted the loop");
+                        n++;
+                        if (i == 0) continue a;
+                        if (i == 1) continue b;
+                        break a;
+                    }
+                }
+                n + "," + i
+            "#},
+            js_str!("3,2"),
+        ),
+        TestAction::assert_eq(
+            indoc! {r#"
+                var n = 0, guard = 0;
